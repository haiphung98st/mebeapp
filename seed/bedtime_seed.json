      "createdAt": "2024-01-03T00:00:00Z",
      "updatedAt": "2024-01-03T00:00:00Z",
      "updatedBy": null,
      "content": {
        "paragraphs": [
          { "index": 0, "text": "Khi màn đêm buông xuống, những ngôi sao nhỏ bắt đầu thức dậy." },
          { "index": 1, "text": "Sao Bắc cất giọng trước, nhẹ nhàng và trong trẻo." },
          { "index": 2, "text": "Sao Hôm tiếp nối, thêm vào những nốt nhạc dịu dàng." },
          { "index": 3, "text": "Cả bầu trời như một dàn đồng ca khổng lồ, hát ru cho trái đất." },
          { "index": 4, "text": "Những chú bé nghe tiếng hát, mắt từ từ khép lại." },
          { "index": 5, "text": "Giấc mơ đẹp ùa về, đầy màu sắc và tiếng cười." },
          { "index": 6, "text": "Đêm nay và mọi đêm, những ngôi sao vẫn hát, bảo vệ giấc ngủ của bé." }
        ],
        "fullAudioPath": null
      }
