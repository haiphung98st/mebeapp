            "updatedBy": null,
            "content": {
                "paragraphs": [
                    {
                        "index": 0,
                        "text": "Gấu con tung tăng chạy về hang sau một ngày dài chơi đùa trong rừng."
                    },
                    {
                        "index": 1,
                        "text": "Nhưng khi đến cửa hang, gấu con chợt nhận ra chiếc chăn bông yêu thích của mình đã rơi mất đâu rồi."
                    },
                    {
                        "index": 2,
                        "text": "Sóc nhỏ nghe thấy, liền chạy đi tìm cùng gấu con, lục tung từng đám lá khô."
                    },
                    {
                        "index": 3,
                        "text": "Nhím con cũng góp sức, nhẹ nhàng dò tìm dưới những gốc cây mà không làm đau ai."
                    },
                    {
                        "index": 4,
                        "text": "Cuối cùng, các bạn tìm thấy chiếc chăn mắc trên một bụi cây nhỏ gần suối."
                    },
                    {
                        "index": 5,
                        "text": "Gấu con ôm chặt chiếc chăn ấm, cảm ơn các bạn, rồi cuộn mình ngủ ngon trong hang."
                    }
                ],
