            "updatedBy": null,
            "content": {
                "paragraphs": [
                    {
                        "index": 0,
                        "text": "Trên một chiếc lá sen nhỏ, có một hạt giống bé xíu đang tìm một nơi để ngủ qua đêm."
                    },
                    {
                        "index": 1,
                        "text": "Chiếc lá sen trôi êm đềm theo dòng sông được ánh trăng rải bạc lên mặt nước."
                    },
                    {
                        "index": 2,
                        "text": "Đi qua khúc sông có đàn đom đóm bay lượn, hạt giống khe khẽ vẫy chào."
                    },
                    {
                        "index": 3,
                        "text": "Dòng sông chảy chậm dần, chậm dần, như đang hát một bài ru nho nhỏ."
                    },
                    {
                        "index": 4,
                        "text": "Chiếc lá sen dừng lại bên một bờ cát mềm, nơi có ánh trăng chiếu sáng dịu dàng nhất."
                    },
                    {
                        "index": 5,
                        "text": "Hạt giống nhắm mắt lại, ngủ một giấc thật sâu, mơ về ngày mai sẽ nảy mầm thành hoa."
                    }
                ],
