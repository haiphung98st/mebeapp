    {
      "id": "story_cloud_friends",
      "title": "Những đám mây bạn bè",
      "slug": "nhung-dam-may-ban-be",
      "summary": "Trên bầu trời cao, những đám mây kết bạn với nhau và cùng nhau tạo ra những hình thù thú vị.",
      "categoryId": "nature",
      "ageGroups": ["1_3y", "3_6y"],
      "tags": ["mây", "bầu trời", "bạn bè"],
      "coverPath": null,
      "durationSec": 240,
      "paragraphCount": 6,
      "isPremium": false,
      "status": "published",
      "version": 1,
      "voiceId": null,
      "ttsProvider": null,
      "charCount": 560,
      "sortOrder": 2,
      "publishedAt": "2024-01-02T00:00:00Z",
      "createdAt": "2024-01-02T00:00:00Z",
      "updatedAt": "2024-01-02T00:00:00Z",
      "updatedBy": null,
      "content": {
        "paragraphs": [
          { "index": 0, "text": "Trên bầu trời xanh thẳm, có những đám mây trắng bồng bềnh." },
          { "index": 1, "text": "Đám mây Bông gặp đám mây Xốp và cùng nhau chơi trò biến hình." },
          { "index": 2, "text": "Bông biến thành con voi, Xốp biến thành con thuyền." },
          { "index": 3, "text": "Gió nhẹ thổi qua, hai bạn mây cười khúc khích với nhau." },
          { "index": 4, "text": "Khi hoàng hôn xuống, các đám mây nhuộm màu hồng rực rỡ." },
          { "index": 5, "text": "Và tất cả chìm vào giấc ngủ, chờ một ngày mới tươi sáng hơn." }
        ],
        "fullAudioPath": null
      }
    },
    {
      "id": "story_star_lullaby",
      "title": "Bài ca của những ngôi sao",
      "slug": "bai-ca-cua-nhung-ngoi-sao",
      "summary": "Mỗi đêm, những ngôi sao nhỏ hát ru cho các bé ngủ ngoan. Hãy lắng nghe bài ca kỳ diệu ấy.",
      "categoryId": "lullaby",
      "ageGroups": ["0_12m", "1_3y", "pregnancy"],
      "tags": ["sao", "ru ngủ", "đêm"],
      "coverPath": null,
      "durationSec": 300,
      "paragraphCount": 7,
      "isPremium": true,
      "status": "published",
      "version": 1,
      "voiceId": null,
      "ttsProvider": null,
