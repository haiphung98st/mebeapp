            "updatedBy": null,
            "content": {
                "paragraphs": [
                    {
                        "index": 0,
                        "text": "Trên bầu trời xanh thẳm, có những đám mây trắng bồng bềnh."
                    },
                    {
                        "index": 1,
                        "text": "Đám mây Bông gặp đám mây Xốp và cùng nhau chơi trò biến hình."
                    },
                    {
                        "index": 2,
                        "text": "Bông biến thành con voi, Xốp biến thành con thuyền."
                    },
                    {
                        "index": 3,
                        "text": "Gió nhẹ thổi qua, hai bạn mây cười khúc khích với nhau."
                    },
                    {
                        "index": 4,
                        "text": "Khi hoàng hôn xuống, các đám mây nhuộm màu hồng rực rỡ."
                    },
                    {
                        "index": 5,
                        "text": "Và tất cả chìm vào giấc ngủ, chờ một ngày mới tươi sáng hơn."
                    }
                ],
                "fullAudioPath": null
            }
        },
