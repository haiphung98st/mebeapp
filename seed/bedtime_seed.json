            ],
            "coverPath": null,
            "durationSec": 214,
            "paragraphCount": 6,
            "isPremium": false,
            "status": "published",
            "version": 1,
            "voiceId": null,
            "ttsProvider": null,
            "charCount": 500,
            "sortOrder": 4,
            "publishedAt": "2024-02-01T00:00:00Z",
            "createdAt": "2024-02-01T00:00:00Z",
            "updatedAt": "2024-02-01T00:00:00Z",
            "updatedBy": null,
            "content": {
                "paragraphs": [
                    {
                        "index": 0,
                        "text": "Ngày xưa, có một chú đom đóm nhỏ bay mãi trong rừng mà không tìm được đường về."
                    },
                    {
                        "index": 1,
                        "text": "Trời tối dần, chú đom đóm run rẩy đậu lên một cành lá, bụng đèn của chú cũng mờ đi vì mệt."
                    },
                    {
                        "index": 2,
                        "text": "Ông Trăng nhìn thấy, bèn treo cây đèn sáng của mình lên cao nhất ngọn cây."
                    },
                    {
                        "index": 3,
                        "text": "Ánh sáng dịu dàng của ông Trăng rọi xuống, chỉ cho chú đom đóm con đường nhỏ về tổ."
                    },
                    {
                        "index": 4,
                        "text": "Chú đom đóm cảm ơn ông Trăng, rồi nhẹ nhàng chui vào chiếc lá ấm nơi mẹ đang chờ."
                    },
                    {
                        "index": 5,
                        "text": "Từ đêm đó, ông Trăng luôn treo đèn thật cao, để không bé nào phải lạc đường về giấc ngủ."
                    }
                ],
                "fullAudioPath": null
            }
        },
