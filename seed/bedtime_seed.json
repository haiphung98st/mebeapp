            "content": {
                "paragraphs": [
                    {
                        "index": 0,
                        "text": "Đêm nay, ánh trăng tròn chiếu sáng cả khu rừng nhỏ."
                    },
                    {
                        "index": 1,
                        "text": "Chú thỏ con nằm trong ổ nhưng mắt cứ mở to, không chịu nhắm lại."
                    },
                    {
                        "index": 2,
                        "text": "Mẹ thỏ đến bên, nhẹ nhàng hát một bài ru quen thuộc."
                    },
                    {
                        "index": 3,
                        "text": "Tiếng hát của mẹ như dòng suối mát, chảy vào giấc mơ êm đềm."
                    },
                    {
                        "index": 4,
                        "text": "Và chú thỏ con chìm vào giấc ngủ sâu, nụ cười nhỏ trên môi."
                    }
