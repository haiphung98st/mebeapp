rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile avatar — owner only. Path: avatars/{uid}.jpg
    match /avatars/{fileName} {
      allow read, write: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    // Baby photo — owner only. Path: avatars/{uid}/{babyId}.jpg
    match /avatars/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Memory Group audio uploads — owner only.
    match /voiceJournal/{uid}/{babyId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /soundscape/{uid}/{babyId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Bedtime ambient sounds — static app content, publicly readable.
    // Managed by admins only (no client writes).
    match /bedtime_sounds/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Bedtime lullaby tracks — static app content, publicly readable.
    match /bedtime_lullaby/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
